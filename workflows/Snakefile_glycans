from math import ceil
import os

from snake_common import (
    CONFIG_INI,
    PDB_NAME,
    GLYCAN_MODEL,
    PDB_PATH,
    PIPELINE_PDB_PATH,
    INITIAL_RELAX,
    LOCAL_PARALLEL_ROSETTA,
    INITIAL_RELAX_BEST_PDB,
    RUN_LABEL,
    SNAKEMAKE_DEBUG,
    RESULT_DIR,
    POSITIONS_DIR,
    POSITIONS_LIST,
    OUT_DIR,
    ANALYSIS_MARKER,
    SCOREFILE_NAME,
    NSTRUCT,
    GLYCAN_BATCH_SIZE,
)
from snakemake.exceptions import WorkflowError

if GLYCAN_MODEL != "glycans":
    raise WorkflowError(
        f"Snakefile_glycans is only intended for glycan_model = 'glycans', "
        f"but config.ini has glycan_model = '{GLYCAN_MODEL}'."
    )

wildcard_constraints:
    position_id = r"[\d_]+",
    batch_id    = r"\d+"

if INITIAL_RELAX:
    ruleorder:
        initial_relax > prepare_positions > glycan_masking_batch > merge_position_batches > merge_scores > analyze
else:
    ruleorder:
        prepare_positions > glycan_masking_batch > merge_position_batches > merge_scores > analyze


rule all:
    input:
        ANALYSIS_MARKER


if INITIAL_RELAX:
    rule initial_relax:
        input:
            pdb=PDB_PATH,
            config=CONFIG_INI,
            script="scripts/run_initial_relax.sh",
            pick="scripts/pick_best_relaxed_pdb.py",
        output:
            INITIAL_RELAX_BEST_PDB,
        threads: LOCAL_PARALLEL_ROSETTA
        resources:
            runtime=2880,
            mem_mb=16000,
        shell:
            "bash scripts/run_initial_relax.sh {input.pdb} {input.config} {output}"


checkpoint prepare_positions:
    input:
        CONFIG_INI,
        pdb=PIPELINE_PDB_PATH,
        "scripts/prepare_positions.sh",
        "scripts/run_prepare_positions.sh",
    output:
        directory(POSITIONS_DIR),
        list_file = POSITIONS_LIST,
    params:
        dir = POSITIONS_DIR,
        debug = SNAKEMAKE_DEBUG,
    threads: 1
    shell:
        "bash scripts/run_prepare_positions.sh {params.dir} {params.debug} {input.pdb}"


def _sort_position_id(pid):
    try:
        return int(pid.split("_")[0])
    except (ValueError, AttributeError):
        return 0


def _position_ids():
    cp = checkpoints.prepare_positions.get()
    with open(cp.output.list_file) as f:
        ids = sorted((l.strip() for l in f if l.strip()), key=_sort_position_id)
    return ids


def _batch_input(wildcards):
    """Return all batch score files for a given position."""
    n_batches = ceil(NSTRUCT / GLYCAN_BATCH_SIZE)
    return [
        os.path.join(
            RESULT_DIR,
            "out_by_position",
            wildcards.position_id,
            f"{PDB_NAME}_position{wildcards.position_id}_batch{b}.sc",
        )
        for b in range(1, n_batches + 1)
    ]


rule glycan_masking_batch:
    input:
        pdb = ancient(PIPELINE_PDB_PATH),
        config = CONFIG_INI,
        script = "scripts/run_glycan_masking.sh",
    output:
        scorefile = os.path.join(
            RESULT_DIR,
            "out_by_position",
            "{position_id}",
            f"{PDB_NAME}_position{{position_id}}_batch{{batch_id}}.sc",
        ),
    params:
        position_id = "{position_id}",
        batch_id = lambda wildcards: int(wildcards.batch_id),
        batch_size = GLYCAN_BATCH_SIZE,
        total_nstruct = NSTRUCT,
    threads: 1
    resources:
        runtime = 2880,   # 48 hours walltime (min) for Rosetta on HPC
        mem_mb = 16000,
    shell:
        "bash scripts/run_glycan_masking.sh "
        "{params.position_id} {input.pdb} {input.config} $(dirname {output.scorefile}) "
        "{params.batch_id} {params.batch_size} {params.total_nstruct}"


rule merge_position_batches:
    input:
        _batch_input,
    output:
        merged = os.path.join(
            RESULT_DIR,
            "out_by_position",
            "{position_id}",
            f"{PDB_NAME}_position{{position_id}}.sc",
        ),
    threads: 1
    shell:
        "python3 scripts/merge_score_files.py {output.merged} {input}"


def _merged_score_input(wildcards):
    """
    Return the per-position score files Snakemake should create.
    Per-position files are named {pdb_name}_position{position_id}.sc for easier
    identification; the final merged file (SCOREFILE_NAME) has no position in the name.

    DEBUG: We intentionally do not check os.path.exists here because
    this function is evaluated before upstream rules run. It yields
    the expected per-position paths so that merge_position_batches and merge_scores
    are scheduled.
    """
    ids = _position_ids()
    return [
        os.path.join(RESULT_DIR, "out_by_position", pid, f"{PDB_NAME}_position{pid}.sc")
        for pid in ids
    ]


rule merge_scores:
    input:
        score_files = _merged_score_input,
        script = "scripts/merge_score_files.py",
    output:
        merged = os.path.join(OUT_DIR, SCOREFILE_NAME),
    threads: 1
    shell:
        "python3 scripts/merge_score_files.py {output.merged} {input.score_files}"


rule analyze:
    input:
        scorefile = os.path.join(OUT_DIR, SCOREFILE_NAME),
        config = CONFIG_INI,
        pdb = PIPELINE_PDB_PATH,
        script = "scripts/run_analysis.sh",
    output:
        ANALYSIS_MARKER,
    threads: 1
    shell:
        "bash scripts/run_analysis.sh {input.config} {input.scorefile} {input.pdb} "
        "{PDB_NAME} {output} {OUT_DIR}"

