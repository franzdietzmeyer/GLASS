/*
 * GLASS Nextflow — local profile (workstation / single node).
 *
 * Tune concurrency here for lab-wide defaults, or set nextflow_local_queue_size in config/config.ini
 * (emitted as params.local_queue_size via glass_config_json.py).
 *
 * Rosetta-labeled processes use lower memory on local than on Slurm (see main nextflow.config).
 */

process {
    executor = 'local'
    withLabel: 'rosetta' {
        memory = '2.GB'
    }
}

executor {
    queueSize = params.local_queue_size
    cpus = params.local_queue_size
}
