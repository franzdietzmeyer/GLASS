/*
 * GLASS Nextflow — Slurm profile (HPC).
 *
 * Per-site defaults: edit process.queue or add flags via config.ini (see glass_config_json.py):
 *   nextflow_slurm_queue, nextflow_slurm_cluster_options,
 *   nextflow_slurm_time_* / nextflow_slurm_memory_* for labels rosetta_initial_relax, rosetta_nogly,
 *   rosetta_glycans, nf_light.
 *
 * Walltime/memory map to #SBATCH. Override one process with process.withName { ... } in a custom .config.
 */

process {
    executor = 'slurm'
    queue = { params.slurm_queue }
    clusterOptions = { params.slurm_cluster_options_extra?.toString()?.trim() ?: '' }
}

executor {
    // Max concurrent Slurm jobs Nextflow will submit (not cluster capacity).
    queueSize = 100
}
