/*
 * GLASS Nextflow — Slurm profile (HPC).
 *
 * Per-site defaults: edit process.queue or add flags via config.ini:
 *   nextflow_slurm_queue, nextflow_slurm_time, nextflow_slurm_memory, nextflow_slurm_cluster_options
 * (see glass_config_json.py → params, and README "Where to tune local vs Slurm").
 *
 * Walltime and memory for Rosetta come from params.rosetta_process_time / rosetta_process_memory
 * (Nextflow maps them to #SBATCH). Use cluster_options only for extras (-A, --constraint, etc.).
 */

process {
    executor = 'slurm'
    queue = { params.slurm_queue }
    clusterOptions = { params.slurm_cluster_options_extra?.toString()?.trim() ?: '' }
}

executor {
    // Max concurrent Slurm jobs Nextflow will submit (not cluster capacity).
    queueSize = 100
}
