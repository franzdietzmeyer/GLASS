/*
 * Nextflow configuration for GLASS (additive; Snakemake remains the default for some sites).
 * Run from repository root: ./run_glass_nextflow.sh <local|slurm>
 *
 * DEBUG: export GLASS_NEXTFLOW_DEBUG=1 before run_glass_nextflow.sh to log the resolved command.
 */

manifest {
    name = 'GLASS'
    description = 'GLASS Nextflow orchestration (parallel Rosetta with tolerant merge)'
    author = 'GLASS'
    // Align with conda env in environments/nextflow.yml
    nextflowVersion = '>=24.10.0'
}

// Params are supplied via -params-file from workflows/nextflow/glass_config_json.py (merged with these defaults).
params {
    launch_dir = ''
    // Max concurrent tasks when using -profile local (same idea as workflows/profiles/local/config.yaml cores: 5).
    // Override: edit here, or pass -params-file / CLI -params local_queue_size=N, or nextflow run ... -qs N
    local_queue_size = 5
    // Fallbacks if -params-file is partial (full set comes from workflows/nextflow/glass_config_json.py).
    initial_relax = false
    initial_relax_nstruct = 10
    glycan_model = 'no_glycans'
}

process {
    // Match Snakemake Slurm defaults (workflows/profiles/slurm/config.yaml): long Rosetta jobs.
    withLabel: 'rosetta' {
        time   = '48h'
        memory = '5.GB'
        cpus   = 1
    }

    // Log mirroring to results/.../logs/ is implemented in main.nf (per-process afterScript).
    // Global afterScript in this file breaks on Nextflow 25+ (task is null in config scope).
}

profiles {
    local {
        process {
            executor = 'local'
            withLabel: 'rosetta' {
                memory = '2.GB'
            }
        }
        executor {
            // Match config.ini nextflow_local_queue_size (see glass_config_json.py).
            queueSize = params.local_queue_size
            cpus = params.local_queue_size
        }
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'paul'
        // Walltime and memory for typical Rosetta glycan_masking jobs (override on your cluster).
        process.clusterOptions = '-t 48:00:00 --mem=5GB'
        executor {
            queueSize = 100
        }
    }
}
