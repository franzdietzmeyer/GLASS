/*
 * Nextflow configuration for GLASS (sole workflow driver).
 * Run from repository root: ./run_glass_nextflow.sh <local|slurm>
 *
 * Executor-specific settings: conf/local.config and conf/slurm.config (see conf/README.md).
 * Experiment options: config/config.ini → glass_config_json.py → -params-file.
 *
 * DEBUG: export GLASS_NEXTFLOW_DEBUG=1 before run_glass_nextflow.sh to log the resolved command.
 */

manifest {
    name = 'GLASS'
    description = 'GLASS Nextflow orchestration (parallel Rosetta with tolerant merge)'
    author = 'GLASS'
    nextflowVersion = '>=24.10.0'
}

// Defaults; merged with -params-file from workflows/nextflow/glass_config_json.py
params {
    launch_dir = ''
    local_queue_size = 5
    initial_relax = false
    initial_relax_nstruct = 10
    // From glass_config_json: basename stem for outputs (prefix + pdb_name when initial_relax uses -out:prefix).
    workflow_pdb_stem = ''
    glycan_model = 'no_glycans'
    // Rosetta / light task resources (overridden from config.ini via glass_config_json.py)
    initial_relax_process_time = '1h'
    initial_relax_process_memory = '2.GB'
    nogly_process_time = '10m'
    nogly_process_memory = '2.GB'
    glycans_process_time = '48h'
    glycans_process_memory = '5.GB'
    light_process_time = '30m'
    light_process_memory = '2.GB'
    slurm_queue = 'paul'
    slurm_cluster_options_extra = ''
    pipeline_debug = false
}

process {
    withLabel: 'rosetta_initial_relax' {
        time   = { params.initial_relax_process_time }
        memory = { params.initial_relax_process_memory }
        cpus   = 1
    }
    withLabel: 'rosetta_nogly' {
        time   = { params.nogly_process_time }
        memory = { params.nogly_process_memory }
        cpus   = 1
    }
    withLabel: 'rosetta_glycans' {
        time   = { params.glycans_process_time }
        memory = { params.glycans_process_memory }
        cpus   = 1
    }
    withLabel: 'nf_light' {
        time   = { params.light_process_time }
        memory = { params.light_process_memory }
        cpus   = 1
    }
}

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
}
