from snake_common import (
    CONFIG_INI,
    PDB_NAME,
    GLYCAN_MODEL,
    PDB_PATH,
    RUN_LABEL,
    SNAKEMAKE_DEBUG,
    RESULT_DIR,
    POSITIONS_DIR,
    POSITIONS_LIST,
    OUT_DIR,
    ANALYSIS_MARKER,
    SCOREFILE_NAME,
)
from snakemake.exceptions import WorkflowError
import os

if GLYCAN_MODEL != "no_glycans":
    raise WorkflowError(
        f"Snakefile_no_glycans is only intended for glycan_model = 'no_glycans', "
        f"but config.ini has glycan_model = '{GLYCAN_MODEL}'."
    )

wildcard_constraints:
    position_id = r"[\d_]+"

ruleorder:
    prepare_positions > glycan_masking > merge_scores > analyze


rule all:
    input:
        ANALYSIS_MARKER


RUN_TOKEN = os.path.join(RESULT_DIR, ".run_token")


def _retry_token_if_failed(wildcards):
    """
    Only add RUN_TOKEN as an input if this position previously failed.

    If a previous run created a placeholder scorefile plus a FAILED marker, the
    presence of RUN_TOKEN forces Snakemake to rerun this job on the next invocation.
    """
    failed_marker = os.path.join(
        RESULT_DIR, "out_by_position", wildcards.position_id, "FAILED"
    )
    return RUN_TOKEN if os.path.exists(failed_marker) else []


checkpoint prepare_positions:
    input:
        CONFIG_INI,
        PDB_PATH,
        "scripts/prepare_positions.sh",
        "scripts/run_prepare_positions.sh",
    output:
        directory(POSITIONS_DIR),
        list_file = POSITIONS_LIST,
    params:
        dir = POSITIONS_DIR,
        debug = SNAKEMAKE_DEBUG,
    threads: 1
    shell:
        "bash scripts/run_prepare_positions.sh {params.dir} {params.debug}"


rule glycan_masking:
    input:
        pdb = ancient(PDB_PATH),
        config = CONFIG_INI,
        script = "scripts/run_glycan_masking.sh",
        token = _retry_token_if_failed,
    output:
        scorefile = os.path.join(RESULT_DIR, "out_by_position", "{position_id}", f"{PDB_NAME}_position{{position_id}}.sc"),
    params:
        position_id = "{position_id}",
    threads: 1
    resources:
        runtime = 2880,   # 48 hours walltime (min) for Rosetta runs on HPC
        mem_mb = 16000,
    shell:
        "bash scripts/run_glycan_masking.sh {params.position_id} {input.pdb} {input.config} $(dirname {output.scorefile})"


def _sort_position_id(pid):
    try:
        return int(pid.split("_")[0])
    except (ValueError, AttributeError):
        return 0


def _merged_score_input(wildcards):
    """
    Return the per-position score files Snakemake should create.
    Per-position files are named {pdb_name}_position{position_id}.sc for easier
    identification; the final merged file (SCOREFILE_NAME) has no position in the name.

    DEBUG: We intentionally do not check os.path.exists here because
    this function is evaluated before upstream rules run. It yields
    the expected per-position paths so that glycan_masking and merge_scores
    are scheduled.
    """
    cp = checkpoints.prepare_positions.get()
    with open(cp.output.list_file) as f:
        ids = sorted((l.strip() for l in f if l.strip()), key=_sort_position_id)

    return [
        os.path.join(RESULT_DIR, "out_by_position", pid, f"{PDB_NAME}_position{pid}.sc")
        for pid in ids
    ]


rule merge_scores:
    input:
        score_files = _merged_score_input,
        script = "scripts/merge_score_files.py",
    output:
        merged = os.path.join(OUT_DIR, SCOREFILE_NAME),
    threads: 1
    shell:
        "python3 scripts/merge_score_files.py {output.merged} {input.score_files}"


rule analyze:
    input:
        scorefile = os.path.join(OUT_DIR, SCOREFILE_NAME),
        config = CONFIG_INI,
        pdb = PDB_PATH,
        script = "scripts/run_analysis.sh",
    output:
        ANALYSIS_MARKER,
    threads: 1
    shell:
        "bash scripts/run_analysis.sh {input.config} {input.scorefile} {input.pdb} "
        "{PDB_NAME} {output} {OUT_DIR}"

