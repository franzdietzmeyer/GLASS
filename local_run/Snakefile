"""
GLASS Snakemake workflow
========================

Three steps: (1) prepare positions, (2) glycan masking per position, (3) merge and analyze.
Positions are discovered at runtime via a checkpoint; see scripts/README.md.

All outputs go under a single result directory: results/<pdb_name>_<glycan_model>/
  - positions/       positions.txt (one position_id per line)
  - out_by_position/ per-position score outputs
  - Full_run.sc      merged score file
  - analysis_results/
"""

import os
import configparser
from snakemake.exceptions import WorkflowError

# -----------------------------------------------------------------------------
# Config (from config.ini)
# -----------------------------------------------------------------------------

CONFIG_INI = "config.ini"
if not os.path.exists(CONFIG_INI):
    raise WorkflowError(f"Config file not found: {CONFIG_INI}")

ini = configparser.ConfigParser()
ini.read(CONFIG_INI)
section = "DEFAULT"

try:
    PDB_NAME = ini[section]["pdb_name"].strip()
    GLYCAN_MODEL = ini[section]["glycan_model"].strip()
except KeyError as e:
    raise WorkflowError(f"Missing required key in {CONFIG_INI}: {e}")

PDB_PATH = os.path.join("input_files", f"{PDB_NAME}.pdb")
RUN_LABEL = ini[section].get("snakemake_run_label", "default").strip()
SNAKEMAKE_DEBUG = ini[section].get("snakemake_debug", "false").strip().lower() == "true"

# Single result directory per run: results/<pdb>_<glycan_model>/
RESULT_DIR = os.path.join("results", f"{PDB_NAME}_{GLYCAN_MODEL}")
POSITIONS_DIR = os.path.join(RESULT_DIR, "positions")
POSITIONS_LIST = os.path.join(POSITIONS_DIR, "positions.txt")
OUT_DIR = RESULT_DIR  # merged scores and analysis_output go here
ANALYSIS_MARKER = os.path.join(RESULT_DIR, f".analysis_done_{RUN_LABEL}")

wildcard_constraints:
    position_id = r"[\d_]+"

ruleorder:
    prepare_positions > glycan_masking > merge_scores > analyze


# -----------------------------------------------------------------------------
# Target
# -----------------------------------------------------------------------------

rule all:
    input:
        ANALYSIS_MARKER


# -----------------------------------------------------------------------------
# Step 1: Prepare positions (writes positions.txt only)
# -----------------------------------------------------------------------------

checkpoint prepare_positions:
    input:
        CONFIG_INI,
        PDB_PATH,
        "scripts/prepare_positions.sh",
        "scripts/run_prepare_positions.sh",
    output:
        directory(POSITIONS_DIR),
        list_file = POSITIONS_LIST,
    params:
        dir = POSITIONS_DIR,
        debug = SNAKEMAKE_DEBUG,
    threads: 1
    shell:
        "bash scripts/run_prepare_positions.sh {params.dir} {params.debug}"


# -----------------------------------------------------------------------------
# Step 2: Glycan masking (one job per position)
# -----------------------------------------------------------------------------

rule glycan_masking:
    input:
        pdb = PDB_PATH,
        config = CONFIG_INI,
        script = "scripts/run_glycan_masking.sh",
    output:
        scorefile = os.path.join(RESULT_DIR, "out_by_position", "{position_id}", "Full_run.sc"),
    params:
        position_id = "{position_id}",
    threads: 1
    shell:
        "bash scripts/run_glycan_masking.sh {params.position_id} {input.pdb} {input.config} $(dirname {output.scorefile})"


# -----------------------------------------------------------------------------
# Step 3: Merge score files into one Full_run.sc
# -----------------------------------------------------------------------------

def _sort_position_id(pid):
    try:
        return int(pid.split("_")[0])
    except (ValueError, AttributeError):
        return 0


def _merged_score_input(wildcards):
    cp = checkpoints.prepare_positions.get()
    with open(cp.output.list_file) as f:
        ids = sorted((l.strip() for l in f if l.strip()), key=_sort_position_id)
    return expand(os.path.join(RESULT_DIR, "out_by_position", "{pid}", "Full_run.sc"), pid=ids)


rule merge_scores:
    input:
        score_files = _merged_score_input,
        script = "scripts/merge_score_files.py",
    output:
        merged = os.path.join(OUT_DIR, "Full_run.sc"),
    threads: 1
    shell:
        "python3 scripts/merge_score_files.py {output.merged} {input.score_files}"


# -----------------------------------------------------------------------------
# Step 4: Run analysis once
# -----------------------------------------------------------------------------

rule analyze:
    input:
        scorefile = os.path.join(OUT_DIR, "Full_run.sc"),
        config = CONFIG_INI,
        pdb = PDB_PATH,
        script = "scripts/run_analysis.sh",
    output:
        ANALYSIS_MARKER,
    threads: 1
    shell:
        "bash scripts/run_analysis.sh {input.config} {input.scorefile} {input.pdb} " \
        "{PDB_NAME} {output} {OUT_DIR}"
