from snake_common import (
    CONFIG_INI,
    PDB_NAME,
    GLYCAN_MODEL,
    PDB_PATH,
    RUN_LABEL,
    SNAKEMAKE_DEBUG,
    RESULT_DIR,
    POSITIONS_DIR,
    POSITIONS_LIST,
    OUT_DIR,
    ANALYSIS_MARKER,
)
from snakemake.exceptions import WorkflowError
import os

if GLYCAN_MODEL != "no_glycans":
    raise WorkflowError(
        f"Snakefile_no_glycans is only intended for glycan_model = 'no_glycans', "
        f"but config.ini has glycan_model = '{GLYCAN_MODEL}'."
    )

wildcard_constraints:
    position_id = r"[\\d_]+"

ruleorder:
    prepare_positions > glycan_masking > merge_scores > analyze


rule all:
    input:
        ANALYSIS_MARKER


checkpoint prepare_positions:
    input:
        CONFIG_INI,
        PDB_PATH,
        "scripts/prepare_positions.sh",
        "scripts/run_prepare_positions.sh",
    output:
        directory(POSITIONS_DIR),
        list_file = POSITIONS_LIST,
    params:
        dir = POSITIONS_DIR,
        debug = SNAKEMAKE_DEBUG,
    threads: 1
    shell:
        "bash scripts/run_prepare_positions.sh {params.dir} {params.debug}"


rule glycan_masking:
    input:
        pdb = PDB_PATH,
        config = CONFIG_INI,
        script = "scripts/run_glycan_masking.sh",
    output:
        scorefile = os.path.join(RESULT_DIR, "out_by_position", "{position_id}", "Full_run.sc"),
    params:
        position_id = "{position_id}",
    threads: 1
    shell:
        "bash scripts/run_glycan_masking.sh {params.position_id} {input.pdb} {input.config} $(dirname {output.scorefile})"


def _sort_position_id(pid):
    try:
        return int(pid.split("_")[0])
    except (ValueError, AttributeError):
        return 0


def _merged_score_input(wildcards):
    """
    Return only those per-position score files that actually exist.

    This allows the workflow to continue and still produce a merged
    Full_run.sc and plots even when some positions failed completely
    (e.g. due to Rosetta filters removing all outputs).
    """
    cp = checkpoints.prepare_positions.get()
    with open(cp.output.list_file) as f:
        ids = sorted((l.strip() for l in f if l.strip()), key=_sort_position_id)

    candidates = [
        os.path.join(RESULT_DIR, "out_by_position", pid, "Full_run.sc")
        for pid in ids
    ]
    existing = [p for p in candidates if os.path.exists(p)]

    if not existing:
        raise WorkflowError(
            "No per-position score files (Full_run.sc) were found. "
            "All positions appear to have failed; nothing to merge."
        )
    return existing


rule merge_scores:
    input:
        score_files = _merged_score_input,
        script = "scripts/merge_score_files.py",
    output:
        merged = os.path.join(OUT_DIR, "Full_run.sc"),
    threads: 1
    shell:
        "python3 scripts/merge_score_files.py {output.merged} {input.score_files}"


rule analyze:
    input:
        scorefile = os.path.join(OUT_DIR, "Full_run.sc"),
        config = CONFIG_INI,
        pdb = PDB_PATH,
        script = "scripts/run_analysis.sh",
    output:
        ANALYSIS_MARKER,
    threads: 1
    shell:
        "bash scripts/run_analysis.sh {input.config} {input.scorefile} {input.pdb} "
        "{PDB_NAME} {output} {OUT_DIR}"

