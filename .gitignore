# =============================================================================
# Project-specific exclusions
# =============================================================================

# Local run directories (keep structure but exclude content)
local_run/*_out_*/
local_run/input_files/*.pdb
local_run/helper_scripts/__pycache__/
local_run/helper_scripts/*.pyc
local_run/helper_scripts/plots/

# Keep important directories but exclude their contents
!local_run/input_files/
!local_run/helper_scripts/
!local_run/input_files/.gitkeep
!local_run/helper_scripts/.gitkeep

# Configuration files that might contain sensitive information
config_local.ini
config_private.ini
secrets.ini

# Large data files
*.h5
*.hdf5
*.nc
*.netcdf
*.zarr

